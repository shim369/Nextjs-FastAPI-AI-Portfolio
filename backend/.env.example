# 必須: Google AI Studio で発行した Gemini API キー（実際の値は .env に書く。このファイルには書かない）
GEMINI_API_KEY=
# 任意: 使用するモデル名（未設定時は app/config.py のデフォルト）
GEMINI_MODEL=

# 以下はすべて任意。未設定時は app/config.py のデフォルト値を使う
# Gemini 1 回の呼び出しのタイムアウト（秒）と最大出力トークン数
LLM_TIMEOUT_SECONDS=
MAX_OUTPUT_TOKENS=
# 一時的なエラー (5xx) のリトライ回数
LLM_MAX_RETRIES=
# エージェントループの最大反復回数と、1 リクエストの時間予算（秒）
AGENT_MAX_ITERATIONS=
AGENT_BUDGET_SECONDS=
# 入力文字数の上限と、送信する会話履歴の件数
MAX_INPUT_CHARS=
MAX_HISTORY=
# レート制限（0 で無効）
RATE_LIMIT_PER_IP_PER_MINUTE=
RATE_LIMIT_PER_IP_PER_DAY=
RATE_LIMIT_GLOBAL_PER_MINUTE=

# お問い合わせフォーム（未設定ならフォームは「現在利用できません」を返す）
# 受け取るメールアドレス
CONTACT_TO_EMAIL=
# 送信に使う SMTP。Gmail は SMTP_USER に送信元の Gmail アドレス、SMTP_PASS にアプリパスワードを書く
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# reCAPTCHA v3 のシークレットキー。空なら検証しない。
# 対になるサイトキーは frontend の NEXT_PUBLIC_RECAPTCHA_SITE_KEY（2つは同じ reCAPTCHA v3 のキーの組にする）
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=
# お問い合わせのレート制限（0 で無効）
CONTACT_RATE_LIMIT_PER_IP_PER_MINUTE=
CONTACT_RATE_LIMIT_PER_IP_PER_DAY=
CONTACT_RATE_LIMIT_GLOBAL_PER_MINUTE=

# AI チャットの get_blog_posts が使う、TECH BLOG（Astro + microCMS）の microCMS。
# ページの記録欄は frontend が同じ microCMS を読むため、ローカルでは frontend/.env にも同じ値を書く（Vercel では1か所の設定を両方が読む）
# サービスドメインは https://xxx.microcms.io の xxx。API キーは blogs エンドポイントの GET 権限だけを付けたものを使う
MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=
