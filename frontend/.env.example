# 記録（ブログ）欄の取得元：技術ブログ「TECH BLOG」の microCMS（実際の値は .env.local に書く。このファイルには書かない）
# サービスドメインは https://xxx.microcms.io の xxx。API キーは blogs エンドポイントの GET 権限だけを付けたものを使う
MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=

# 任意：reCAPTCHA v3 のサイトキー（未設定なら lib/config.ts の既定値）と、サイトの URL（metadataBase）
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_SITE_URL=
