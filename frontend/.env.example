# 記録（ブログ）欄の取得元：技術ブログ「TECH BLOG」の microCMS（実際の値は .env.local か .env に書く。このファイルには書かない）
# AI チャットのツールも同じ microCMS を読むため、backend/.env にも同じ値を書く（Vercel では1か所の設定を両方が読む）
# サービスドメインは https://xxx.microcms.io の xxx。API キーは blogs エンドポイントの GET 権限だけを付けたものを使う
MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=

# reCAPTCHA v3 のサイトキー（未設定なら lib/config.ts の既定値）。backend の RECAPTCHA_SECRET_KEY と同じキーの組にする。
# ビルド時にページへ埋め込まれるため、Vercel にも設定し、変えたら再デプロイする
# 任意：サイトの URL（metadataBase。未設定なら app/layout.tsx の既定値）
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
NEXT_PUBLIC_SITE_URL=
